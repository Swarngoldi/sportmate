# MongoDB connection string
# For local MongoDB: mongodb://localhost:27017/sportmate
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/sportmate
MONGO_URI=mongodb://localhost:27017/sportmate

# JWT secret key (generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production

# Server port
PORT=5000

# Environment
NODE_ENV=development

# App URL used in reset-password email links
FRONTEND_URL=http://localhost:5173/index.html

# Google OAuth web client ID
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Gmail SMTP sender for welcome, match request, and forgot-password emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_app_sender_gmail@gmail.com
SMTP_PASS=your_16_character_gmail_app_password
MAIL_FROM=SportMate <your_app_sender_gmail@gmail.com>

# Set to false only when offline/local DNS prevents domain checks during development
EMAIL_DOMAIN_CHECK=true
